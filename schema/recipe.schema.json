      "$ref": "#/$defs/Toolchain"
    },
    "policy": {
      "$ref": "#/$defs/Policy"
    },
    "gate": {
      "$ref": "#/$defs/Gate",
      "description": "The release gate; fields set here win over _global.yaml's"
    },
    "ecosystems": {
      "items": {
        "discriminator": {
          "mapping": {
            "cargo": "#/$defs/CargoEco",
            "dockerfile": "#/$defs/DockerfileEco",
            "files": "#/$defs/FilesEco",
            "gomod": "#/$defs/GoModEco",
            "gradle": "#/$defs/GradleEco",
            "maven": "#/$defs/MavenEco",
            "npm": "#/$defs/NodeEco",
            "pnpm": "#/$defs/NodeEco",
            "python": "#/$defs/PythonEco",
            "yarn": "#/$defs/NodeEco"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/GoModEco"
          },
          {
            "$ref": "#/$defs/CargoEco"
          },
          {
            "$ref": "#/$defs/MavenEco"
          },
          {
            "$ref": "#/$defs/NodeEco"
          },
          {
            "$ref": "#/$defs/PythonEco"
          },
          {
            "$ref": "#/$defs/GradleEco"
          },
          {
            "$ref": "#/$defs/DockerfileEco"
          },
          {
            "$ref": "#/$defs/FilesEco"
          }
        ]
      },
      "title": "Ecosystems",
