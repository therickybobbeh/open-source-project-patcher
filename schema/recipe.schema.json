        "setup": {
          "items": {
            "type": "string"
          },
          "title": "Setup",
          "type": "array"
        },
        "command": {
          "description": "May contain `{{skip_args}}`, `{{skip_regex}}`, `{{skip_file}}`",
          "title": "Command",
          "type": "string"
        },
        "skipVia": {
          "anyOf": [
            {
              "$ref": "#/$defs/SkipVia"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "services": {
          "anyOf": [
            {
              "$ref": "#/$defs/Services"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "junit": {
          "description": "Globs of JUnit XML files to collect",
          "items": {
            "type": "string"
          },
          "title": "Junit",
          "type": "array"
        },
        "timeoutMinutes": {
          "default": 90,
          "title": "Timeoutminutes",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "runAs": {
          "default": "root",
