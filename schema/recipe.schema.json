        "type": "array"
      },
      "title": "Holds",
      "type": "object"
    },
    "prepare": {
      "description": "Commands run after checkout, before the first scan (e.g. `mvn -DskipTests install` so Trivy can resolve POMs from ~/.m2)",
      "items": {
        "type": "string"
      },
      "title": "Prepare",
      "type": "array"
    },
    "regen": {
      "items": {
        "$ref": "#/$defs/Regen"
      },
      "title": "Regen",
      "type": "array"
