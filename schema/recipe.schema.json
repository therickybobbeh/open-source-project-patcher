{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "How a component recipe's binary is built (inside a buildx stage, cross-compiled per platform).",
      "properties": {
        "builder": {
          "default": "golang:{{go}}",
          "description": "Builder image; `{{go}}` = the Go version the component needs",
          "title": "Builder",
          "type": "string"
        },
        "build": {
          "description": "Shell command run in the checkout (/src) with TARGETOS/TARGETARCH set; must write `output`",
          "title": "Build",
          "type": "string"
        },
        "output": {
          "description": "Path of the built binary inside the builder, e.g. /out/helm",
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "build",
        "output"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Build": {
      "additionalProperties": false,
      "properties": {
        "setup": {
          "description": "Commands run before image builds (e.g. `make build`)",
          "items": {
            "type": "string"
          },
          "title": "Setup",
          "type": "array"
        },
        "platforms": {
          "description": "Platforms the line is released for. The release builds each one on its own native runner (linux/amd64, linux/arm64) and merges them",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Platforms",
          "type": "array"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/ImageSpec"
          },
          "minItems": 1,
          "title": "Images",
          "type": "array"
        },
        "timeoutMinutes": {
          "default": 60,
          "description": "Per image build (and per component overlay); a build that hangs is killed and retried once",
          "title": "Timeoutminutes",
          "type": "integer"
        }
      },
      "required": [
        "images"
      ],
      "title": "Build",
      "type": "object"
    },
    "BundledJars": {
      "additionalProperties": false,
      "description": "A third-party Java distribution the image unpacks (Maven in /usr/share/maven, Kafka's libs/): the image's\nbuild doesn't control its jars, so vulnerable ones are swapped for fixed releases from Maven Central.",
      "properties": {
        "paths": {
          "description": "Directory prefixes (or jar paths) in the image, e.g. `usr/share/maven/` or `opt/kafka/libs/`. Fixable findings in jars under them are swapped after the build",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "level": {
          "$ref": "#/$defs/Level",
          "default": "patch",
          "description": "How far a swapped jar may move (the policy cap for these swaps). The release-age rule and holds (`maven` key) apply as for source bumps"
        }
      },
      "required": [
        "paths"
      ],
      "title": "BundledJars",
      "type": "object"
    },
    "CargoEco": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cargo",
          "title": "Type",
          "type": "string"
        },
        "dirs": {
          "description": "Workspace roots (contain Cargo.lock)",
          "items": {
            "type": "string"
          },
          "title": "Dirs",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "CargoEco",
      "type": "object"
    },
    "ComponentRef": {
      "additionalProperties": false,
      "description": "A third-party binary bundled in this recipe's images, rebuilt from source and swapped in.",
      "properties": {
        "recipe": {
          "description": "Component recipe (mode: component) that patches and builds it",
          "title": "Recipe",
          "type": "string"
        },
        "path": {
          "description": "Where the binary lives in the image, e.g. /usr/local/bin/helm",
          "title": "Path",
          "type": "string"
        },
        "tag": {
          "default": "v{{version}}",
          "description": "Upstream tag for the version found in the image (`{{version}}` = without v)",
          "title": "Tag",
          "type": "string"
        },
        "images": {
          "description": "Image keys to apply it to (default: every image)",
          "items": {
            "type": "string"
          },
          "title": "Images",
          "type": "array"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pin the bundled version explicitly",
          "title": "Version"
        },
        "versionFrom": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Read it from a file in the parent's checkout (e.g. hack/tool-versions.sh)"
        },
        "versionCommand": {
          "description": "Run the binary in the image with these args and take the first version in its output (e.g. [version])",
          "items": {
            "type": "string"
          },
          "title": "Versioncommand",
          "type": "array"
        }
      },
      "required": [
        "recipe",
        "path"
      ],
      "title": "ComponentRef",
      "type": "object"
    },
    "CooldownBypass": {
      "additionalProperties": false,
      "properties": {
        "severities": {
          "description": "Findings of these severities skip the age rule",
          "items": {
            "type": "string"
          },
          "title": "Severities",
          "type": "array"
        },
        "kev": {
          "default": true,
          "description": "CVEs on CISA's Known Exploited Vulnerabilities list skip the age rule",
          "title": "Kev",
          "type": "boolean"
        }
      },
      "title": "CooldownBypass",
      "type": "object"
    },
    "CopaOptions": {
      "additionalProperties": false,
      "properties": {
        "libraries": {
          "default": false,
          "description": "Also patch language packages (COPA_EXPERIMENTAL library patching: pip and npm packages inside the image); for closed-source images",
          "title": "Libraries",
          "type": "boolean"
        },
        "level": {
          "$ref": "#/$defs/Level",
          "default": "patch",
          "description": "How far Copa may move library versions"
        }
      },
      "title": "CopaOptions",
      "type": "object"
    },
    "DerivedEdit": {
      "additionalProperties": false,
      "description": "A second edit that follows the main version change (URL, checksum...).",
      "properties": {
        "var": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Var"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex with a named group `value`",
          "title": "Pattern"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Template, e.g. `https://download.redis.io/redis-{{version}}.tar.gz`",
          "title": "Value"
        },
        "sha256Of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Template URL to download; its sha256 becomes the value",
          "title": "Sha256Of"
        }
      },
      "title": "DerivedEdit",
      "type": "object"
    },
    "DockerfileEco": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "dockerfile",
          "title": "Type",
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "title": "Files",
          "type": "array"
        },
        "pinDigest": {
          "default": true,
          "title": "Pindigest",
          "type": "boolean"
        },
        "ignore": {
          "description": "Image-name regexes to leave alone",
          "items": {
            "type": "string"
          },
          "title": "Ignore",
          "type": "array"
        },
        "level": {
          "$ref": "#/$defs/Level",
          "default": "patch",
          "description": "How far a base image tag may move"
        },
        "minVersions": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Release lines base images must not fall below, by image name (`node`, `alpine`, `library/node`), e.g. {node: \"24\"} for a build stage on an end-of-life Node. A tag below its line moves to the newest tag of the same shape in it (24: 24.x.y, 3.24: 3.24.x), whatever `level` says; tags at or above it follow `level`",
          "title": "Minversions",
          "type": "object"
        }
      },
      "required": [
        "type"
      ],
      "title": "DockerfileEco",
      "type": "object"
    },
    "FileEdit": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "Path (glob allowed) relative to the checkout",
          "title": "File",
          "type": "string"
        },
        "var": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Variable name: matches NAME=ver, NAME ver, NAME: ver (ENV/ARG/export ok)",
          "title": "Var"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex with a named group `version`",
          "title": "Pattern"
        },
        "to": {
          "default": "latest-patch",
          "description": "`latest-patch`, `latest-minor`, or an explicit version",
          "title": "To",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where to look up `latest-*` versions"
        },
        "derived": {
          "items": {
            "$ref": "#/$defs/DerivedEdit"
          },
          "title": "Derived",
          "type": "array"
        }
      },
      "required": [
        "file"
      ],
      "title": "FileEdit",
      "type": "object"
    },
    "FilesEco": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "files",
          "title": "Type",
          "type": "string"
        },
        "edits": {
          "items": {
            "$ref": "#/$defs/FileEdit"
          },
          "minItems": 1,
          "title": "Edits",
          "type": "array"
        }
      },
      "required": [
        "type",
        "edits"
      ],
      "title": "FilesEco",
      "type": "object"
    },
    "Gate": {
      "additionalProperties": false,
      "description": "What a released image may still contain, decided by the Rego policy in policy/ (OPA, through conftest) on each\nimage's final scan. Findings a VEX statement explains never count.",
      "properties": {
        "enforce": {
          "default": false,
          "description": "true: a release the gate denies stops before it is signed, and its patch PR opens as a draft. false: the verdict is only reported",
          "title": "Enforce",
          "type": "boolean"
        },
        "failOn": {
          "$ref": "#/$defs/GateFailOn"
        }
      },
      "title": "Gate",
      "type": "object"
    },
    "GateFailOn": {
      "additionalProperties": false,
      "properties": {
        "fixable": {
          "description": "Severities of findings that have a fix released and are still in the image, which fail the gate, e.g. [CRITICAL, HIGH]",
          "items": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "title": "Fixable",
          "type": "array"
        },
        "unfixed": {
          "description": "Severities of findings that have no fix released yet, which fail the gate, e.g. [CRITICAL]",
          "items": {
            "enum": [
              "CRITICAL",
              "HIGH",
              "MEDIUM",
              "LOW",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "title": "Unfixed",
          "type": "array"
        }
      },
      "title": "GateFailOn",
      "type": "object"
    },
    "GoModEco": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "gomod",
          "title": "Type",
          "type": "string"
        },
        "dirs": {
          "description": "Module directories (each has a go.mod); globs allowed",
          "items": {
            "type": "string"
          },
          "title": "Dirs",
          "type": "array"
        },
        "replaceGroups": {
          "items": {
            "$ref": "#/$defs/ReplaceGroup"
          },
          "title": "Replacegroups",
          "type": "array"
        },
        "bumpToolchainDirective": {
          "default": true,
          "description": "Raise an existing `toolchain` directive to the fixed Go version",
          "title": "Bumptoolchaindirective",
          "type": "boolean"
        }
      },
      "required": [
        "type"
      ],
      "title": "GoModEco",
      "type": "object"
    },
    "GradleEco": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "gradle",
          "title": "Type",
          "type": "string"
        },
        "dirs": {
          "description": "Gradle build roots (settings.gradle[.kts] or build.gradle[.kts])",
          "items": {
            "type": "string"
          },
          "title": "Dirs",
          "type": "array"
        },
        "catalog": {
          "default": "gradle/libs.versions.toml",
          "description": "Version catalog, relative to the build root",
          "title": "Catalog",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "GradleEco",
      "type": "object"
    },
    "Hold": {
      "additionalProperties": false,
      "description": "Never bump a dependency (or never past `max`).",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "max": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "name",
        "reason"
      ],
      "title": "Hold",
      "type": "object"
    },
    "ImageSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Our image repository name, e.g. `argocd`",
          "title": "Name",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unique key when several variants share a repository (defaults to `name`)",
          "title": "Id"
        },
        "upstream": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upstream image repo (for the baseline scan), e.g. `quay.io/argoproj/argocd`",
          "title": "Upstream"
        },
        "upstreamTag": {
          "default": "{{tag}}",
          "description": "Upstream tag template, also the base of our tag: `{{version}}` strips the leading v, e.g. `{{tag}}-distroless`",
          "title": "Upstreamtag",
          "type": "string"
        },
        "dockerfile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Dockerfile",
          "title": "Dockerfile"
        },
        "context": {
          "default": ".",
          "title": "Context",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "args": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Args",
          "type": "object"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Custom build command instead of buildx; must produce `builtImage`",
          "title": "Command"
        },
        "builtImage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Image ref the custom command produces (template)",
          "title": "Builtimage"
        },
        "smoke": {
          "description": "Args passed to `docker run --rm <image>`; each must exit 0",
          "items": {
            "type": "string"
          },
          "title": "Smoke",
          "type": "array"
        },
        "smokeEnv": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment for the smoke commands (`docker run -e`), e.g. placeholder credentials a distribution requires before it will even validate its config",
          "title": "Smokeenv",
          "type": "object"
        },
        "ownBinaries": {
          "description": "Paths or directory prefixes (in the image) of what this source builds, e.g. `usr/local/bin/dex` or `app/`; anything else is a bundled artifact. Empty = guess from the source scan.",
          "items": {
            "type": "string"
          },
          "title": "Ownbinaries",
          "type": "array"
        },
        "bundledJars": {
          "anyOf": [
            {
              "$ref": "#/$defs/BundledJars"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Jars of a bundled third-party Java distribution: vulnerable ones are replaced with the fixed release from Maven Central (pinned by sha256) in an overlay on the built image, before smoke tests and Copa"
        },
        "copa": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/CopaOptions"
            }
          ],
          "default": true,
          "description": "Copa for leftover OS packages; an object enables library patching too",
          "title": "Copa"
        },
        "tagPattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "image-only: this image's own tag regex when it versions separately from the line",
          "title": "Tagpattern"
        },
        "platforms": {
          "description": "Platforms this image exists for, when fewer than build.platforms: it is built and released for those of build.platforms it lists",
          "items": {
            "type": "string"
          },
          "title": "Platforms",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "ImageSpec",
      "type": "object"
    },
    "Level": {
      "description": "How far a dependency may move without a human: patch < minor < major.",
      "enum": [
        "patch",
        "minor",
        "major"
      ],
      "title": "Level",
      "type": "string"
    },
    "Line": {
      "additionalProperties": false,
      "description": "A release line we track: the newest tag matching `tagPattern` (e.g. every v3.5.x), a pinned\n`tag`, or the head of a `branch` for projects that don't tag releases.",
      "properties": {
        "tagPattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex an upstream tag must match to belong to this line",
          "title": "Tagpattern"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short name used in branch/state keys; defaults to a slug of tagPattern",
          "title": "Name"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pin an exact upstream tag instead of following the newest one",
          "title": "Tag"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Track this branch's head instead of tags (requires `versionFrom` and `name`)",
          "title": "Branch"
        },
        "versionFrom": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionFrom"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "Line",
      "type": "object"
    },
    "MavenEco": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "maven",
          "title": "Type",
          "type": "string"
        },
        "poms": {
          "description": "Reactor root POMs (globs). A finding is patched in the deepest root whose directory contains its pom.xml: explicit versions via versions-maven-plugin, transitives pinned in that root's <dependencyManagement>",
          "items": {
            "type": "string"
          },
          "title": "Poms",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "MavenEco",
      "type": "object"
    },
    "NodeEco": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "npm",
            "pnpm",
            "yarn"
          ],
          "title": "Type",
          "type": "string"
        },
        "dirs": {
          "items": {
            "type": "string"
          },
          "title": "Dirs",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "NodeEco",
      "type": "object"
    },
    "Override": {
      "additionalProperties": false,
      "description": "Force a dependency: if a lower version is found, raise it to `min` (or set exactly `version`).",
      "properties": {
        "name": {
          "description": "Package name; `*` globs allowed (e.g. `golang.org/x/*`)",
          "title": "Name",
          "type": "string"
        },
        "min": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "name",
        "reason"
      ],
      "title": "Override",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/Level",
          "default": "minor"
        },
        "ecosystems": {
          "additionalProperties": {
            "$ref": "#/$defs/Level"
          },
          "description": "Per-ecosystem override of `default`",
          "title": "Ecosystems",
          "type": "object"
        },
        "minReleaseAgeDays": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only bump to versions published at least this many days ago (supply-chain cooldown); unset/0 = off",
          "title": "Minreleaseagedays"
        },
        "cooldownBypass": {
          "$ref": "#/$defs/CooldownBypass"
        }
      },
      "title": "Policy",
      "type": "object"
    },
    "PythonEco": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "python",
          "title": "Type",
          "type": "string"
        },
        "dirs": {
          "description": "Project dirs (globs); the tool is detected per dir",
          "items": {
            "type": "string"
          },
          "title": "Dirs",
          "type": "array"
        },
        "tool": {
          "default": "auto",
          "description": "auto: uv.lock -> uv, poetry.lock -> poetry, Pipfile.lock -> pipenv, requirements.in or a pip-compile / `uv pip compile` header -> pip-tools, other requirements*.txt -> pip",
          "enum": [
            "auto",
            "uv",
            "poetry",
            "pipenv",
            "pip-tools",
            "pip"
          ],
          "title": "Tool",
          "type": "string"
        },
        "toolVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "poetry/pipenv/pip-tools version (default: read from the lockfile header, else a pinned default)",
          "title": "Toolversion"
        }
      },
      "required": [
        "type"
      ],
      "title": "PythonEco",
      "type": "object"
    },
    "RecipeScan": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "default": true,
          "description": "Scan the source tree (`trivy fs`); false for Dockerfile-only projects",
          "title": "Source",
          "type": "boolean"
        },
        "offline": {
          "default": false,
          "description": "`trivy fs --offline-scan`: resolve Maven POMs from the local ~/.m2 only (fill it with `prepare`); avoids Maven Central rate limits",
          "title": "Offline",
          "type": "boolean"
        },
        "reachability": {
          "default": true,
          "description": "Go recipes: run govulncheck on the patched source and suggest VEX statements for remaining findings whose vulnerable code isn't reached",
          "title": "Reachability",
          "type": "boolean"
        },
        "image": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Also plan bumps from findings in the built image's own artifacts (jars, Python packages, node_modules) the source scan can't see; costs one extra run. Default: on for gradle/python",
          "title": "Image"
        },
        "skipDirs": {
          "description": "Extra `trivy fs --skip-dirs` globs (test fixtures, examples)",
          "items": {
            "type": "string"
          },
          "title": "Skipdirs",
          "type": "array"
        },
        "skipFiles": {
          "items": {
            "type": "string"
          },
          "title": "Skipfiles",
          "type": "array"
        }
      },
      "title": "RecipeScan",
      "type": "object"
    },
    "Regen": {
      "additionalProperties": false,
      "properties": {
        "when": {
          "default": "always",
          "enum": [
            "always",
            "replaceGroupMoved",
            "never"
          ],
          "title": "When",
          "type": "string"
        },
        "run": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Run",
          "type": "array"
        }
      },
      "required": [
        "run"
      ],
      "title": "Regen",
      "type": "object"
    },
    "ReplaceGroup": {
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "description": "Regex over module paths, e.g. `^k8s\\.io/(api|apimachinery|client-go)$`",
          "title": "Pattern",
          "type": "string"
        },
        "sameVersion": {
          "default": true,
          "description": "Members that currently share a version move together",
          "title": "Sameversion",
          "type": "boolean"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "ReplaceGroup",
      "type": "object"
    },
    "Services": {
      "additionalProperties": false,
      "properties": {
        "compose": {
          "description": "docker compose file (relative to the checkout)",
          "title": "Compose",
          "type": "string"
        },
        "services": {
          "description": "Subset to start; empty = all",
          "items": {
            "type": "string"
          },
          "title": "Services",
          "type": "array"
        }
      },
      "required": [
        "compose"
      ],
      "title": "Services",
      "type": "object"
    },
    "SkipVia": {
      "additionalProperties": false,
      "properties": {
        "env": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Put the rendered skip args into this env var instead of `{{skip_args}}`",
          "title": "Env"
        },
        "format": {
          "default": "{{skip_args}}",
          "description": "Template; `{{skip_regex}}` = joined skip regex, `{{skip_args}}` = framework args",
          "title": "Format",
          "type": "string"
        }
      },
      "title": "SkipVia",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "repo": {
          "description": "GitHub `owner/name` or a full git URL",
          "title": "Repo",
          "type": "string"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/Line"
          },
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "exclude": {
          "description": "Tag regexes to ignore (e.g. sub-module tags like `api/v2.*`)",
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        }
      },
      "required": [
        "repo",
        "lines"
      ],
      "title": "Source",
      "type": "object"
    },
    "Tests": {
      "additionalProperties": false,
      "properties": {
        "framework": {
          "enum": [
            "go",
            "nextest",
            "surefire",
            "gradle",
            "pytest",
            "jest",
            "vitest",
            "mocha",
            "redis",
            "bats",
            "generic"
