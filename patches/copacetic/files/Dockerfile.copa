# Copa CLI image built from source (added by support-images; upstream publishes no CLI image).
# Copa drives BuildKit and needs `docker`/`buildx` only when using the docker:// or buildx:// addr.
ARG GO_VERSION=1.26.10
FROM --platform=$BUILDPLATFORM golang:${GO_VERSION}-trixie AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS TARGETARCH CLI_VERSION=dev
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
      -ldflags "-s -w -X main.version=${CLI_VERSION} -X github.com/project-copacetic/copacetic/pkg/version.GitVersion=v${CLI_VERSION}" \
      -o /out/copa .

FROM debian:13-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/copa /usr/local/bin/copa
ENTRYPOINT ["copa"]
