diff --git a/ui/pnpm-workspace.yaml b/ui/pnpm-workspace.yaml
index c5fdb06..1c1e045 100644
--- a/ui/pnpm-workspace.yaml
+++ b/ui/pnpm-workspace.yaml
@@ -1,23 +1,18 @@
-# pnpm 11+ no longer reads the "pnpm" field from package.json; settings live here.
-
 overrides:
   '@types/react': ^19.0.0
   '@types/react-dom': ^19.0.0
   rxjs: 7.8.2
-
-# pnpm 11+ errors on un-declared dependency build scripts (strictDepBuilds).
-# None of these were built under pnpm 10 either; keep them off.
+  brace-expansion@1.1.14: 1.1.21
+  brace-expansion@2.1.0: 2.1.7
+  form-data@4.0.5: 4.0.6
+  moment@2.30.1: 2.31.0
+  qs@6.15.2: 6.16.1
+  source-map-js@1.2.1: 1.2.2
 allowBuilds:
-  '@parcel/watcher': false # prebuild download, only used by watch mode
-  '@scarf/scarf': false # analytics, also disabled via scarfSettings
-  argo-ui: false # resolved as a tarball, nothing to build
-  core-js: false # funding banner
-  core-js-pure: false # funding banner
-  esbuild: false # esbuild-loader uses the JS API, not the bin shim
-
-# Don't let pnpm self-manage its version: corepack (Dockerfile, test/container)
-# and pnpm/action-setup (CI) already provision it from `packageManager`. The
-# default would add a second YAML document to pnpm-lock.yaml holding pnpm's own
-# @pnpm/exe packages, which third-party lockfile parsers (Dependabot, Snyk) do
-# not expect.
+  '@parcel/watcher': false
+  '@scarf/scarf': false
+  argo-ui: false
+  core-js: false
+  core-js-pure: false
+  esbuild: false
 pmOnFail: ignore
